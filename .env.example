# Use a trusted HTTPS origin; Buffer does not accept http://localhost callbacks.
APP_BASE_URL=https://receipts.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
BUFFER_CLIENT_ID=
# Required for a confidential app client; omit for a registered public client.
BUFFER_CLIENT_SECRET=
# 32 random bytes, base64 encoded. Generate: openssl rand -base64 32
RECEIPTS_ENCRYPTION_KEY=
# Enable all five scopes on the registered Buffer client; reconnect existing users.
BUFFER_SCOPES=account:read posts:read notes:read notes:write offline_access
PORT=8888

# Only for local HTTPS; use paths to trusted development certificate/key files.
# DEV_TLS_CERT=
# DEV_TLS_KEY=
